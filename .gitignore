# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Local development environments
.venv/
.tmp/
.venv*/

# Generated reference databases and GeoNames build outputs.
# These are large, reproducible from official sources, and never authoritative
# unless their manifests are separately reviewed.
builds/
data/geonames-source/
*.sqlite
*.db

# Job output. The .job-state folder stores plaintext recipient address rows
# as local JSONL checkpoints and must never be committed or uploaded.
.job-state/
test-output/
out/
